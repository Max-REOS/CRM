# Copy to .env.local for local development (never commit the real file).

# Login password shared by Max & Phil (this is an internal 2-user tool, not
# a public system — see build brief section 4).
APP_PASSWORD=change-me

# Random long string, signs the login session cookie. Generate e.g. with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-too

# Bearer secret required by POST /api/scrape (used by the GitHub Actions
# workflow / local `npm run scrape` trigger). Generate the same way.
CRON_SECRET=change-me-as-well

# Optional: Vercel Deploy Hook URL. If set as a GitHub Actions secret
# (VERCEL_DEPLOY_HOOK_URL), the daily scrape workflow pings it after
# committing new leads so a read-only Vercel deployment picks them up.
# Not needed if you host on Railway/Render (see README "Hosting").
VERCEL_DEPLOY_HOOK_URL=
