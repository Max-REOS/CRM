{
  "name": "reos-jarvis",
  "version": "1.0.0",
  "description": "JARVIS — Personal Intelligence System for Max Köhl, REOS Platform GmbH",
  "main": "src/main.js",
  "author": "REOS Platform GmbH",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "docx": "^8.5.0",
    "electron-store": "^8.2.0",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.0",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.reos.jarvis",
    "productName": "REOS JARVIS",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "pwa/**/*",
      "data/.gitkeep"
    ]
  }
}
